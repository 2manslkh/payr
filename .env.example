NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_EXPLORER_URL=
NEXT_PUBLIC_PAYR_CONTRACT_ADDRESS=
# Publication binds the configured chain/contract once. No placeholder deployment is selected automatically.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Base64/base64url encoded random 32-byte session key.
SESSION_ENCRYPTION_KEY=
LINK_ACTIVE_KEY_VERSION=1
LINK_TOKEN_KEY_V1=
# Add LINK_TOKEN_KEY_V2, V3, etc. and retain referenced old versions when rotating publication links.
# Base64/base64url encoded random key of at least 32 bytes.
CONNECTOR_TOKEN_PEPPER=
CRON_SECRET=
PAYR_SIGNER_MODE=local-testnet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ALLOW_TESTNET_LOCAL_SIGNER=false
# A production web host may serve testnet, never production funds.
PAYR_MONEY_MODE=testnet
# Read back from the deployed immutable contract; keep the attestor unfunded.
PAYR_ATTESTOR_ADDRESS=
# Verified older deployments using the same attestor, retained while their invoices remain payable.
PAYR_RETAINED_SETTLEMENT_CONTRACTS=
# Earliest verified deployment block among all current/retained settlement contracts.
PAYR_RECONCILIATION_START_BLOCK=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
TESTNET_ATTESTOR_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Explicit operator opt-in. Keep false until receipt email recipients and content have been approved.
PAYR_RECEIPT_EMAIL_ENABLED=false

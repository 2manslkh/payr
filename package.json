{
  "name": "payr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:local": "node scripts/run-db-tests.mjs",
    "test:release": "node --test scripts/release-utils.test.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:release && pnpm build",
    "verify:arc": "node scripts/verify-arc.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release-pr.mjs",
    "release:tag": "node scripts/tag-release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "jose": "6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@next/env": "16.3.4",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "latest",
    "supabase": "2.116.0",
    "tsx": "latest",
    "typescript": "^5.7.3",
    "vitest": "5.0.0"
  }
}

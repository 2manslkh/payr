{
  "routes": [
    {
      "src": "^/$",
      "continue": true,
      "transforms": [
        { "type": "response.headers", "op": "append", "target": { "key": "Vary" }, "args": "Accept" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/jobs/reconcile", "schedule": "0 0 * * *" },
    { "path": "/api/jobs/receipts", "schedule": "5 0 * * *" },
    { "path": "/api/jobs/outbox", "schedule": "10 0 * * *" }
  ]
}
